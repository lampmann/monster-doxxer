# Game data is user-supplied and never committed. Same rule as pmcrwf: this repo ships
# mechanics and code, never sourcebook content. See DESIGN.md "What may be committed".
data/*
!data/README.md

# Build artefacts from build/embed.py. Quantised vectors ARE safe to commit under
# DESIGN.md's rule (derived numbers, not source text) — but a locally built index is
# large and model-specific, so it stays out unless deliberately added with `git add -f`.
index/*
!index/README.md

node_modules/
__pycache__/
*.pyc
.venv/
.DS_Store
